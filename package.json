{
	"name": "@reclaimprotocol/developer-tools",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/client",
		"packages/agent"
	],
	"scripts": {
		"build": "npm run build --workspaces --if-present",
		"test": "npm test --workspaces --if-present && npm run test:scripts",
		"test:scripts": "node --test tests/*.test.mjs",
		"check": "npm run check --workspaces --if-present",
		"lint": "eslint .",
		"lint:fix": "npm run lint -- --fix",
		"version:bump": "node scripts/bump-version.ts"
	},
	"engines": {
		"node": ">=22.19"
	},
	"devDependencies": {
		"@adiwajshing/eslint-config": "github:adiwajshing/eslint-config#607fc28f986c645194c69047292883ae0d1aec02",
		"@types/node": "^24.0.0",
		"eslint": "^10.0.0",
		"typescript": "^5.9.0"
	}
}
