			"optional": true
		},
		"mailauth": {
			"optional": true
		},
		"mammoth": {
			"optional": true
		},
		"pdfjs-dist": {
			"optional": true
		},
		"postal-mime": {
			"optional": true
		},
		"read-excel-file": {
			"optional": true
		},
		"sax": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/html-to-text": "^9.0.4",
		"@types/node": "^24.0.0",
		"chardet": "2.2.0",
		"fflate": "0.8.3",
		"file-type": "22.2.0",
		"google-auth-library": "11.3.1",
		"html-to-text": "10.0.1",
		"iconv-lite": "0.7.3",
		"mailauth": "7.1.0",
		"mammoth": "1.13.0",
		"openapi-typescript": "^7.13.0",
		"pdfjs-dist": "6.4.299",
		"postal-mime": "4.0.4",
		"read-excel-file": "9.3.12",
		"sax": "1.4.3",
		"typescript": "^5.9.0",
		"yaml": "^2.6.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"typesVersions": {
		"*": {
			"email": [
				"lib/email/index.d.ts"
			],
			"email/core": [
				"lib/email/core/index.d.ts"
			],
			"email/protocol": [
				"lib/email/core/protocol.d.ts"
			],
			"email/contracts": [
				"lib/email/core/contracts.d.ts"
			],
			"email/schemas": [
				"lib/email/core/schemas.d.ts"
			],
			"email/sender": [
				"lib/email/core/sender.d.ts"
			],
			"email/google": [
				"lib/email/core/google.d.ts"
			],
			"email/preview": [
				"lib/email/core/preview.d.ts"
			],
			"email/ai": [
				"lib/email/core/ai.d.ts"
			]
		}
	}
}
