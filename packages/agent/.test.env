# Test-only, non-secret deterministic values. Loaded via --env-file in the
# `test` script (node --env-file=.test.env --test ...). NOT for production.
#
# The agent tests don't need the Builder app. Tests that boot it live in
# packages/app/tests/agent-*.test.ts.

NODE_ENV=test

# Keeps the suites from sending usage data.
RECLAIM_TELEMETRY=0
