RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
PORT=3000
# REQUIRED for the webhook callback to land — Reclaim's servers can't reach
# localhost. Pick ONE:
#   - ngrok (or similar tunnel): run `ngrok http 3000` in a separate
#     terminal and paste the https://<id>.ngrok-free.app URL it prints here.
#   - A dev/staging server you can deploy this to quickly: point this at
#     that server's public URL instead.
# Without either, only the frontend-side flow (opening requestUrl) works —
# the webhook never fires.
PUBLIC_URL=
