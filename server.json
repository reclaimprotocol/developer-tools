{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.reclaimprotocol/builder",
  "title": "Reclaim Protocol Builder",
  "description": "Integrate source-account verification into products. Find, build, test, and maintain providers.",
  "version": "0.1.45",
  "websiteUrl": "https://build.reclaimprotocol.org",
  "icons": [
    {
      "src": "https://avatars.githubusercontent.com/u/130321117?s=400&v=4",
      "mimeType": "image/png",
      "sizes": [
        "400x400"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@reclaimprotocol/agent",
      "version": "0.1.45",
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-y"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "repository": {
    "url": "https://github.com/reclaimprotocol/developer-tools",
    "source": "github"
  }
}
